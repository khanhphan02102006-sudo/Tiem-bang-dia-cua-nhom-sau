@model VideoRentalMVC.Models.Phim

@{
    ViewData["Title"] = "Chi tiết phim";
    var posterUrl = string.IsNullOrWhiteSpace(Model.AnhBiaUrl)
        ? Url.Content("~/images/poster-placeholder.svg")
        : Model.AnhBiaUrl;
}

<h2 class="page-title mb-3">Chi tiết phim</h2>

<div class="glass-panel p-3 fade-in-up">
    <div class="detail-topbar">
        <h5 class="section-header mb-0">Thông tin phim</h5>
        <span class="soft-badge neutral">Mã phim: #@Model.Id</span>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <img src="@posterUrl" class="poster-large shadow-sm" alt="@Model.TenPhim" onerror="this.onerror=null;this.src='@Url.Content("~/images/poster-placeholder.svg")';" />
        </div>
        <div class="col-lg-8">
            <dl class="row info-grid mb-2">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TenPhim)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenPhim)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NuocSanXuat)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NuocSanXuat)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PhimBoLe)</dt>
                <dd class="col-sm-9">
                    <span class="soft-badge @(Model.PhimBoLe ? "info" : "neutral")">@(Model.PhimBoLe ? "Phim bộ" : "Phim lẻ")</span>
                </dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.GiaVon)</dt>
                <dd class="col-sm-9 fw-semibold">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} VNĐ", Model.GiaVon)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MoTa)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MoTa)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NamSanXuat)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NamSanXuat)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TheLoai)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TheLoai)</dd>
            </dl>
        </div>
    </div>

    <div class="action-bar mt-3">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil-square me-1"></i>Sửa</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>
</div>
