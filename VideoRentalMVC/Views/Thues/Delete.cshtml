@model VideoRentalMVC.Models.Thue

@{
    ViewData["Title"] = "Xóa phiếu thuê";
}

<h2 class="page-title mb-3">Xóa phiếu thuê</h2>

<div class="glass-panel p-3 fade-in-up">
    <p class="text-danger fw-semibold mb-3">Bạn có chắc muốn xóa phiếu thuê này không?</p>

    <dl class="row info-grid">
        <dt class="col-sm-3">Băng</dt>
        <dd class="col-sm-9">@(Model.MaBangNavigation?.TenBang)</dd>
        <dt class="col-sm-3">Khách</dt>
        <dd class="col-sm-9">@(Model.MaKhachNavigation?.TenKhach)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NgayThue)</dt>
        <dd class="col-sm-9">@Model.NgayThue.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HanTra)</dt>
        <dd class="col-sm-9">@Model.HanTra.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NgayTra)</dt>
        <dd class="col-sm-9">@(Model.NgayTra?.ToString("dd/MM/yyyy") ?? "-")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TongTien)</dt>
        <dd class="col-sm-9">@string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} VNĐ", Model.TongTien)</dd>
    </dl>

    <form asp-action="Delete" class="action-bar mt-3 js-confirm-submit" data-confirm-message="Bạn có chắc muốn xóa phiếu thuê này?">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </form>
</div>