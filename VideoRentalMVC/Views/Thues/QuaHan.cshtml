@model IEnumerable<VideoRentalMVC.Models.Thue>

@{
    ViewData["Title"] = "Phiếu thuê quá hạn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Phiếu thuê quá hạn</h2>
    <a class="btn btn-outline-dark dashboard-back-btn" asp-action="BaoCao">Quay lại Dashboard</a>
</div>

@if (Model.Any())
{
    <div class="table-shell">
        <table class="table table-striped table-sticky mb-0">
            <thead>
                <tr>
                    <th class="sticky-first">Khách</th>
                    <th>Băng</th>
                    <th>Ngày thuê</th>
                    <th>Hạn trả</th>
                    <th>Số ngày quá hạn</th>
                    <th class="sticky-action"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var soNgayTre = Math.Max(0, (DateTime.Today - item.HanTra.Date).Days);
                    <tr>
                        <td class="sticky-first">@(item.MaKhachNavigation?.TenKhach)</td>
                        <td>@(item.MaBangNavigation?.TenBang)</td>
                        <td>@item.NgayThue.ToString("dd/MM/yyyy")</td>
                        <td>@item.HanTra.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-danger">@soNgayTre ngày</span></td>
                        <td class="sticky-action">
                            <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                            <form asp-action="GiaHan" method="post" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="soNgay" value="3" min="1" max="30" class="form-control form-control-sm d-inline-block" style="width:75px" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Gia hạn</button>
                            </form>
                            <form asp-action="TraBang" method="post" class="d-inline ms-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Trả băng</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <div class="icon">✅</div>
        <div>Hiện tại không có phiếu thuê nào quá hạn.</div>
    </div>
}