@model VideoRentalMVC.Models.Thue

@{
    ViewData["Title"] = "Chỉnh sửa phiếu thuê";
}

<h2 class="page-title mb-3">Chỉnh sửa phiếu thuê</h2>

<div class="row fade-in-up">
    <div class="col-md-6">
        <div class="form-shell">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="MaBang" class="control-label"></label>
                    <select asp-for="MaBang" class="form-control" asp-items="ViewBag.MaBang"></select>
                    <span asp-validation-for="MaBang" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MaKhach" class="control-label"></label>
                    <select asp-for="MaKhach" class="form-control" asp-items="ViewBag.MaKhach"></select>
                    <span asp-validation-for="MaKhach" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NgayThue" class="control-label"></label>
                    <input asp-for="NgayThue" class="form-control" />
                    <span asp-validation-for="NgayThue" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="HanTra" class="control-label"></label>
                    <input asp-for="HanTra" class="form-control" />
                    <span asp-validation-for="HanTra" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NgayTra" class="control-label"></label>
                    <input asp-for="NgayTra" class="form-control" />
                    <span asp-validation-for="NgayTra" class="text-danger"></span>
                </div>
                <div class="form-group form-check mt-1">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="DaTraTienThue" /> @Html.DisplayNameFor(model => model.DaTraTienThue)
                    </label>
                </div>
                <div class="form-group mt-3 action-bar">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}